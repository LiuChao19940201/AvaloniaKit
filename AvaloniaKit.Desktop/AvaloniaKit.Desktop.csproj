<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!-- ═══ NativeAOT ═══
       · PublishAot 只在 dotnet publish 时触发原生编译；日常 F5/build 仍是 JIT，
         但会启用 AOT 兼容性分析器，提前在编译期暴露不兼容代码
       · 旧写法 '$(PublishProtocol)' != '' 只有 VS 发布向导会满足，
         命令行 dotnet publish 永远不触发，已更正
       · 发布命令：dotnet publish -c Release -r win-x64（需安装 VS C++ 生成工具） -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <!-- AOT 产物体积/启动优化：不变量全球化 + 服务器GC关闭 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <OptimizationPreference>Speed</OptimizationPreference>
  </PropertyGroup>

  <!-- ★ 防裁剪保根：sqlite-net 是反射 ORM，实体类的属性 getter/setter 与
       SQLite-net 自身的映射元数据被裁剪后会导致存库静默失效 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="AvaloniaKit" />
    <TrimmerRootAssembly Include="SQLite-net" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Desktop 平台专用包 -->
    <PackageReference Include="Avalonia.Desktop" />
    <!-- 音频播放：MediaFoundation 流式解码 + WaveOut 输出 -->
    <PackageReference Include="NAudio" />
    <!-- 抖音视频覆盖层：WebView2 HWND 子窗口 -->
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!-- 显式引用以覆盖 Avalonia.Desktop 传递依赖的漏洞版本（NU1903） -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="sqlite-net-pcl" />
    <PackageReference Include="SQLitePCLRaw.bundle_green" />
    <!-- 显式引用以覆盖 bundle_green 传递依赖的漏洞版本（NU1903） -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaKit\AvaloniaKit.csproj" />
  </ItemGroup>

  <!-- WebView2 包无条件引入 Wpf/WinForms 封装层（本项目只用 Core），
       剔除以消除 WindowsBase 版本冲突警告 MSB3277 -->
  <Target Name="TrimWebView2UiRefs" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)"
                 Condition="$([System.String]::new('%(Reference.Identity)').Contains('WebView2.Wpf')) Or $([System.String]::new('%(Reference.Identity)').Contains('WebView2.WinForms'))" />
    </ItemGroup>
  </Target>
</Project>
