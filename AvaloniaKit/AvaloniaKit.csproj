<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- ★ 应用版本号（发版唯一修改点）：编译期写入程序集元数据，
         “我的”页面运行时读取展示，四端统一 -->
    <Version>1.0.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Avalonia 12 已移除 Avalonia.Diagnostics（DevTools 独立化）与
         Avalonia.ReactiveUI（移交 ReactiveUI 团队）；项目统一用 CommunityToolkit.Mvvm -->
    <PackageReference Include="Irihi.Ursa" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\UserControls\Discover\Games\GameBoxesUserControl.axaml.cs">
      <DependentUpon>GameBoxesUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\UserControls\Discover\Games\TetrisUserControl.axaml.cs">
      <DependentUpon>TetrisUserControl.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
