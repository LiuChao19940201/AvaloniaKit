<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaKit.ViewModels.UserControls.Discover.Games"
             x:Class="AvaloniaKit.Views.UserControls.Discover.Games.MinesweeperUserControl"
             d:DesignWidth="350" d:DesignHeight="700"
             x:DataType="vm:MinesweeperViewModel">

    <Design.DataContext>
        <vm:MinesweeperViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Background="{DynamicResource SemiColorBg1}">

        <!-- ══ 导航栏 ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SemiColorBg0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,0,1"
                Padding="0,6">
            <Grid ColumnDefinitions="48,*,48">

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                           Text="扫雷"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding GoBackCommand}"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsTabStop="False"
                        Focusable="False">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15.41 7.41L14 6L8 12L14 18L15.41 16.59L10.83 12Z"
                                  Fill="{DynamicResource SemiColorText0}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 重开 -->
                <Button Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding StartCommand}"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsRunning}"
                        IsTabStop="False"
                        Focusable="False">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 5V2L8 6l4 4V7c3.31 0 6 2.69 6 6a6 6 0 0 1-6 6 6 6 0 0 1-6-6H4a8 8 0 0 0 8 8 8 8 0 0 0 8-8 8 8 0 0 0-8-8z"
                                  Fill="{DynamicResource SemiColorText0}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- ══ 信息栏 ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="16,10,16,4">
            <Border Grid.Column="0" Margin="0,0,4,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="8,6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="剩余雷" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MinesLeft}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="4,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="8,6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="用时(秒)" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Elapsed}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="4,0,0,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="8,6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="最佳(秒)" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BestTime}" FontSize="20" FontWeight="Bold" Foreground="#FF6B35" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 棋盘 ══ -->
        <Border Grid.Row="2" Margin="16,8"
                CornerRadius="10"
                Background="#263238"
                ClipToBounds="True">
            <Panel>
                <Viewbox Stretch="Uniform">
                    <ItemsControl x:Name="Board" ItemsSource="{Binding Cells}" Margin="4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="14" Columns="10"
                                             Width="220" Height="308"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MineCell">
                                <Panel Margin="0.5" Background="Transparent">
                                    <!-- 已翻开底 -->
                                    <Border CornerRadius="2" Background="#37474F"
                                            IsVisible="{Binding IsRevealed}"/>
                                    <!-- 踩中的雷标红 -->
                                    <Border CornerRadius="2" Background="#D32F2F"
                                            IsVisible="{Binding IsMineHit}"/>
                                    <!-- 未翻开凸起 -->
                                    <Border CornerRadius="2" Background="#78909C"
                                            BorderBrush="#90A4AE" BorderThickness="0,1,0,0"
                                            IsVisible="{Binding !IsRevealed}"/>
                                    <!-- 数字 / 雷 -->
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{Binding TextColor}"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsRevealed}"/>
                                    <!-- 旗 -->
                                    <TextBlock Text="🚩" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding IsFlagged}"/>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <!-- 未开始遮罩 -->
                <Border IsVisible="{Binding !IsRunning}" Background="#CC000000" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

                        <StackPanel IsVisible="{Binding IsGameOver}" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="💥 GAME OVER"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="#FF6B35"
                                       HorizontalAlignment="Center" LetterSpacing="2"/>
                            <TextBlock Text="{Binding Elapsed, StringFormat='用时：{0} 秒'}"
                                       FontSize="14" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsWin}" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="🎉 扫雷成功"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="#FFD600"
                                       HorizontalAlignment="Center" LetterSpacing="2"/>
                            <TextBlock Text="{Binding Elapsed, StringFormat='用时：{0} 秒'}"
                                       FontSize="14" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="4"
                                    IsVisible="{Binding !IsGameOver}">
                            <TextBlock IsVisible="{Binding !IsWin}"
                                       Text="MINESWEEPER"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" LetterSpacing="4"/>
                        </StackPanel>

                        <Button Command="{Binding StartCommand}"
                                Content="开 始 游 戏"
                                HorizontalAlignment="Center"
                                Padding="28,12" CornerRadius="24"
                                Background="#FF6B35" Foreground="White"
                                FontWeight="SemiBold" FontSize="14" BorderThickness="0"
                                IsTabStop="False" Focusable="False"/>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>

        <!-- ══ 插旗模式开关 ══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SemiColorBg0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,*">
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsFlagMode}"
                              Padding="24,10" CornerRadius="20"
                              IsTabStop="False" Focusable="False"
                              ToolTip.Tip="开启后点击格子为插旗（桌面端也可直接右键插旗）">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🚩" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="插旗模式" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</UserControl>
