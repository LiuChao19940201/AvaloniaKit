<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AvaloniaKit.ViewModels.UserControls.Discover.Games"
             x:Class="AvaloniaKit.Views.UserControls.Discover.Games.SudokuUserControl"
             d:DesignWidth="350" d:DesignHeight="700"
             x:DataType="vm:SudokuViewModel">

    <Design.DataContext>
        <vm:SudokuViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Background="{DynamicResource SemiColorBg1}">

        <!-- ══ 导航栏 ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SemiColorBg0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,0,1"
                Padding="0,6">
            <Grid ColumnDefinitions="48,*,48">

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                           Text="数独"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SemiColorText0}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding GoBackCommand}"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsTabStop="False"
                        Focusable="False">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path Data="M15.41 7.41L14 6L8 12L14 18L15.41 16.59L10.83 12Z"
                                  Fill="{DynamicResource SemiColorText0}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <!-- ══ 信息栏 ══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" Margin="16,10,16,4">
            <Border Grid.Column="0" Margin="0,0,3,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="难度" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Difficulty}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Margin="3,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="用时(秒)" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Elapsed}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Margin="3,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="最快(秒)" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding BestTime}" FontSize="16" FontWeight="Bold" Foreground="#FF6B35" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Margin="3,0,0,0"
                    Background="{DynamicResource SemiColorBg0}" CornerRadius="8" Padding="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="提示" FontSize="10" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding HintsLeft}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource SemiColorText0}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 棋盘 ══ -->
        <Border Grid.Row="2" Margin="16,8"
                CornerRadius="10"
                Background="#2C2C2E"
                ClipToBounds="True"
                VerticalAlignment="Center">
            <Panel>
                <Viewbox Stretch="Uniform">
                    <ItemsControl x:Name="Board" ItemsSource="{Binding Cells}" Margin="6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="9" Columns="9"
                                             Width="288" Height="288"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SudokuCell">
                                <Border BorderBrush="#55FFFFFF"
                                        BorderThickness="{Binding BoxBorder}"
                                        Background="Transparent">
                                    <Panel>
                                        <!-- 选中高亮 -->
                                        <Border Background="#59FF6B35"
                                                IsVisible="{Binding IsSelected}"/>
                                        <!-- 冲突高亮 -->
                                        <Border Background="#40EF5350"
                                                IsVisible="{Binding IsConflict}"/>
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding TextColor}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>

                <!-- 未开始 / 难度选择遮罩 -->
                <Border IsVisible="{Binding !IsRunning}" Background="#CC000000" CornerRadius="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

                        <StackPanel IsVisible="{Binding IsWin}" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="🎉 挑战成功"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="#FFD600"
                                       HorizontalAlignment="Center" LetterSpacing="2"/>
                            <TextBlock Text="{Binding Elapsed, StringFormat='用时：{0} 秒'}"
                                       FontSize="14" Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <TextBlock IsVisible="{Binding !IsWin}"
                                   Text="SUDOKU"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" LetterSpacing="6"/>

                        <TextBlock Text="选择难度开始"
                                   FontSize="13" Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Command="{Binding StartCommand}" CommandParameter="easy"
                                    Content="简单"
                                    Padding="20,10" CornerRadius="20"
                                    Background="#4CAF50" Foreground="White"
                                    FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                                    IsTabStop="False" Focusable="False"/>
                            <Button Command="{Binding StartCommand}" CommandParameter="normal"
                                    Content="普通"
                                    Padding="20,10" CornerRadius="20"
                                    Background="#FF6B35" Foreground="White"
                                    FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                                    IsTabStop="False" Focusable="False"/>
                            <Button Command="{Binding StartCommand}" CommandParameter="hard"
                                    Content="困难"
                                    Padding="20,10" CornerRadius="20"
                                    Background="#E74C3C" Foreground="White"
                                    FontWeight="SemiBold" FontSize="13" BorderThickness="0"
                                    IsTabStop="False" Focusable="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Panel>
        </Border>

        <!-- ══ 数字键盘 ══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource SemiColorBg0}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <StackPanel Spacing="8">
                <!-- 1-9 -->
                <UniformGrid Rows="1" Columns="9">
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="1" Content="1" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="2" Content="2" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="3" Content="3" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="4" Content="4" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="5" Content="5" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="6" Content="6" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="7" Content="7" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="8" Content="8" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                    <Button Command="{Binding InputNumberCommand}" CommandParameter="9" Content="9" Classes="numkey" Theme="{DynamicResource SolidButton}" CornerRadius="8" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" IsTabStop="False" Focusable="False"/>
                </UniformGrid>

                <!-- 功能键 -->
                <Grid ColumnDefinitions="*,*,*" >
                    <Button Grid.Column="0" Command="{Binding EraseCommand}"
                            Classes="Warning" Theme="{DynamicResource SolidButton}"
                            CornerRadius="8" Margin="2,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="⌫ 擦除" FontSize="13"
                            IsTabStop="False" Focusable="False"/>
                    <Button Grid.Column="1" Command="{Binding HintCommand}"
                            Classes="Success" Theme="{DynamicResource SolidButton}"
                            CornerRadius="8" Margin="2,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="💡 提示" FontSize="13"
                            IsTabStop="False" Focusable="False"/>
                    <Button Grid.Column="2" Command="{Binding StartCommand}" CommandParameter="normal"
                            Theme="{DynamicResource SolidButton}"
                            CornerRadius="8" Margin="2,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Content="🔄 新局" FontSize="13"
                            IsTabStop="False" Focusable="False"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
