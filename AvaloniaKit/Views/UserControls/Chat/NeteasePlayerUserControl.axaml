<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AvaloniaKit.ViewModels.UserControls.Chat"
             mc:Ignorable="d"
             d:DesignWidth="390" d:DesignHeight="760"
             x:Class="AvaloniaKit.Views.UserControls.Chat.NeteasePlayerUserControl"
             x:DataType="vm:NeteasePlayerViewModel">

    <Design.DataContext>
        <vm:NeteasePlayerViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Button.ctrl-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Padding"         Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ctrl-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ★ 唱针：默认抬起 -28°，播放时落下 0°，平滑过渡（仿网易云） -->
        <Style Selector="Canvas#ToneArm">
            <Setter Property="RenderTransform" Value="rotate(-28deg)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.45"
                                                   Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Canvas#ToneArm.playing">
            <Setter Property="RenderTransform" Value="rotate(0deg)"/>
        </Style>
    </UserControl.Styles>

    <!-- ★ 仿网易云：全屏模糊封面背景 + 深色遮罩（两种视图共用） -->
    <Grid Background="#FF15151D">

        <Image Source="{Binding CoverBitmap}"
               Stretch="UniformToFill"
               Effect="blur(60)"
               Opacity="0.9"
               IsVisible="{Binding HasLoadedCover}"/>
        <Border Background="#8C000000"/>

        <DockPanel>

            <!-- ══ 顶部导航 ══ -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="44,*,44"
                  Margin="4,48,4,0">
                <!-- 返回 -->
                <Button Grid.Column="0" Classes="ctrl-btn"
                        Command="{Binding GoBackCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M20 11H7.83L13.42 5.41 12 4 4 12 12 20 13.41 18.59 7.83 13H20V11Z"
                                  Fill="White"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 歌曲信息 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding SongName}"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220"/>
                    <TextBlock Text="{Binding Artist}"
                               FontSize="13"
                               Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="220"/>
                </StackPanel>

                <!-- 切换歌词/封面 -->
                <Button Grid.Column="2" Classes="ctrl-btn"
                        Command="{Binding ToggleViewCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ViewModeName}"
                               FontSize="13" Foreground="#CCFFFFFF"/>
                </Button>
            </Grid>

            <!-- ══ 底部控制区 ══ -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,40" Spacing="0">

                <!-- 状态文字（加载中/错误提示）-->
                <TextBlock Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText.Length}"
                           FontSize="12" Foreground="#99FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- 进度条 + 时间 -->
                <Grid ColumnDefinitions="50,*,50" Margin="16,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTimeStr}"
                               FontSize="12" Foreground="#99FFFFFF"
                               VerticalAlignment="Center"/>
                    <Slider Grid.Column="1"
                            Name="ProgressSlider"
                            Value="{Binding ProgressValue}"
                            Minimum="0" Maximum="100"
                            Margin="8,0"
                            Foreground="#EC4141"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalTimeStr}"
                               FontSize="12" Foreground="#99FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- 控制按钮 -->
                <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,8,0,0">

                    <!-- 播放模式 -->
                    <Button Grid.Column="0" Classes="ctrl-btn"
                            Command="{Binding ToggleRepeatModeCommand}"
                            HorizontalAlignment="Center">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding RepeatModeIcon}"
                                      Fill="#B3FFFFFF"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 上一首 -->
                    <Button Grid.Column="1" Classes="ctrl-btn"
                            Command="{Binding PrevSongCommand}"
                            HorizontalAlignment="Center">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 6H8V18H6ZM9.5 12L18 18V6Z"
                                      Fill="White"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 播放/暂停 主按钮 -->
                    <Button Grid.Column="2" Classes="ctrl-btn"
                            Command="{Binding TogglePlayCommand}"
                            HorizontalAlignment="Center">
                        <Border Width="60" Height="60"
                                CornerRadius="30"
                                Background="#EC4141">
                            <Viewbox Width="34" Height="34"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding PlayBtnIcon}" Fill="White"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Button>

                    <!-- 下一首 -->
                    <Button Grid.Column="3" Classes="ctrl-btn"
                            Command="{Binding NextSongCommand}"
                            HorizontalAlignment="Center">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <Path Data="M6 18L14.5 12 6 6V18ZM16 6V18H18V6H16Z"
                                      Fill="White"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- 喜欢 -->
                    <Button Grid.Column="4" Classes="ctrl-btn"
                            Command="{Binding ToggleLikeCommand}"
                            HorizontalAlignment="Center">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12 21.35L10.55 20.03C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3C9.24 3 10.91 3.81 12 5.08 13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5C22 12.27 18.6 15.36 13.45 20.03L12 21.35Z"
                                      Fill="{Binding LikeColor}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- ══ 中间区域：黑胶封面 OR 歌词（点击可切换，仿网易云） ══ -->
            <Panel Name="CenterPanel" Background="Transparent">

                <!-- ── 黑胶封面视图 ── -->
                <Grid IsVisible="{Binding !IsLyricView}" RowDefinitions="*,Auto">

                    <Panel Grid.Row="0">

                        <!-- 黑胶唱片（DiscPanel 由 code-behind 驱动旋转） -->
                        <Panel Width="300" Height="300"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,64,0,0">
                            <Panel Name="DiscPanel">
                                <!-- 唱片主体 -->
                                <Ellipse Width="300" Height="300">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
                                            <GradientStop Color="#FF2E2E36" Offset="0"/>
                                            <GradientStop Color="#FF17171C" Offset="0.62"/>
                                            <GradientStop Color="#FF101014" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <!-- 唱片纹理环 -->
                                <Ellipse Width="300" Height="300" Stroke="#33FFFFFF" StrokeThickness="1.5"/>
                                <Ellipse Width="276" Height="276" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                <Ellipse Width="252" Height="252" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                <Ellipse Width="228" Height="228" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                <Ellipse Width="206" Height="206" Stroke="#12FFFFFF" StrokeThickness="1"/>

                                <!-- 封面圆图 -->
                                <Border Width="188" Height="188"
                                        CornerRadius="94"
                                        ClipToBounds="True"
                                        Background="#26262E">
                                    <Panel>
                                        <Image Source="{Binding CoverBitmap}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding HasLoadedCover}"/>
                                        <Viewbox Width="56" Height="56"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding !HasLoadedCover}">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12 3V13.55C11.41 13.21 10.73 13 10 13C7.79 13 6 14.79 6 17S7.79 21 10 21 14 19.21 14 17V7H18V3H12Z"
                                                      Fill="#66FFFFFF"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Panel>
                                </Border>

                                <!-- 中心轴帽 -->
                                <Ellipse Width="22" Height="22" Fill="#FF1B1B21"
                                         Stroke="#66FFFFFF" StrokeThickness="1.5"/>
                            </Panel>
                        </Panel>

                        <!-- 唱针（支点在左上角银色圆钮处） -->
                        <Canvas Name="ToneArm"
                                Width="150" Height="170"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="118,0,0,0"
                                RenderTransformOrigin="15%,9%"
                                Classes.playing="{Binding IsPlaying}">
                            <!-- 支点圆钮 -->
                            <Ellipse Canvas.Left="8" Canvas.Top="2"
                                     Width="28" Height="28"
                                     Fill="#E8E8E8" Stroke="#55000000" StrokeThickness="2"/>
                            <!-- 摆臂 -->
                            <Line StartPoint="22,16" EndPoint="72,86"
                                  Stroke="#E0E0E0" StrokeThickness="5"
                                  StrokeLineCap="Round"/>
                            <Line StartPoint="72,86" EndPoint="60,140"
                                  Stroke="#E0E0E0" StrokeThickness="5"
                                  StrokeLineCap="Round"/>
                            <!-- 唱头 -->
                            <Border Canvas.Left="48" Canvas.Top="134"
                                    Width="22" Height="34"
                                    CornerRadius="6"
                                    Background="#D8D8D8"
                                    BorderBrush="#55000000" BorderThickness="1.5"/>
                        </Canvas>
                    </Panel>

                    <!-- 专辑 / 音质信息 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="6"
                                Margin="0,18,0,14">
                        <TextBlock Text="{Binding Album}"
                                   FontSize="13" Foreground="#99FFFFFF"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"/>
                        <TextBlock Text="{Binding QualityText}"
                                   FontSize="11" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ── 歌词视图 ── -->
                <Panel IsVisible="{Binding IsLyricView}">

                    <TextBlock IsVisible="{Binding IsLyricLoading}"
                               Text="歌词加载中…"
                               FontSize="14" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding LyricStatus}"
                               IsVisible="{Binding LyricStatus.Length}"
                               FontSize="15" Foreground="#99FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- ★ 歌词滚动由 code-behind 平滑驱动，当前行始终居中（仿网易云） -->
                    <ScrollViewer Name="LyricScroll"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasLyric}">
                        <ItemsControl Name="LyricItems"
                                      ItemsSource="{Binding LyricLines}"
                                      Margin="32,240,32,280">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LyricLine">
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="{Binding FontSize}"
                                               FontWeight="{Binding FontWeight}"
                                               Foreground="{Binding Foreground}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,10"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>

            </Panel>

        </DockPanel>
    </Grid>
</UserControl>
