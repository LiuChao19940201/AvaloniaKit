<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:chat="using:AvaloniaKit.Views.UserControls.Chat"
			 xmlns:chatVm="using:AvaloniaKit.ViewModels.UserControls.Chat"
			 mc:Ignorable="d"
			 d:DesignWidth="350" d:DesignHeight="700"
			 x:Class="AvaloniaKit.Views.UserControls.Chat.ChatUserControl"
			 x:DataType="chatVm:ChatViewModel">

	<Design.DataContext>
		<chatVm:ChatViewModel />
	</Design.DataContext>

	<ListBox ItemsSource="{Binding ChatList}"
			 Background="{DynamicResource SemiColorBg0}"
			 SelectionMode="Single">

		<ListBox.ItemTemplate>
			<DataTemplate x:DataType="chatVm:ChatItemViewModel">
				<StackPanel>
					<Button Background="Transparent"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Stretch"
							Padding="0" Height="68"
							Command="{Binding $parent[ListBox].((chatVm:ChatViewModel)DataContext).OpenChatCommand}"
							CommandParameter="{Binding}">
						<Grid ColumnDefinitions="72,*,Auto" Margin="0,0,16,0">

							<!-- ── 左列头像区 ── -->
							<Panel Grid.Column="0"
								   Width="46" Height="46"
								   HorizontalAlignment="Center" VerticalAlignment="Center">

								<!-- ★ 天气入口：蓝天渐变 + 阳光穿云 + 雨丝 -->
								<Panel IsVisible="{Binding IsWeather}">
									<Border Width="46" Height="46" CornerRadius="10">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
												<GradientStop Color="#64B9FF" Offset="0"/>
												<GradientStop Color="#3D7EF7" Offset="1"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Viewbox Width="28" Height="28"
											 HorizontalAlignment="Center" VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<!-- 太阳与光晕 -->
											<Ellipse Canvas.Left="1.9" Canvas.Top="1.4" Width="12.2" Height="12.2" Stroke="#66FFF3C0" StrokeThickness="1.3" Fill="Transparent"/>
											<Ellipse Canvas.Left="3.5" Canvas.Top="3" Width="9" Height="9" Fill="#FFD95C"/>
											<!-- 云朵（三圆叠加） -->
											<Ellipse Canvas.Left="6.5" Canvas.Top="11.5" Width="13.5" Height="8" Fill="White"/>
											<Ellipse Canvas.Left="9" Canvas.Top="8.8" Width="8.5" Height="8.5" Fill="White"/>
											<Ellipse Canvas.Left="14.5" Canvas.Top="10" Width="7.5" Height="7.5" Fill="White"/>
											<!-- 雨丝 -->
											<Line StartPoint="9.5,21" EndPoint="8.6,23" Stroke="#CFE9FF" StrokeThickness="1.5" StrokeLineCap="Round"/>
											<Line StartPoint="13.5,21" EndPoint="12.6,23" Stroke="#CFE9FF" StrokeThickness="1.5" StrokeLineCap="Round"/>
											<Line StartPoint="17.5,21" EndPoint="16.6,23" Stroke="#CFE9FF" StrokeThickness="1.5" StrokeLineCap="Round"/>
										</Canvas>
									</Viewbox>
								</Panel>

								<!-- 基金入口：橙红渐变 + 柱状图/上升折线（涨势） -->
								<Panel IsVisible="{Binding IsFundTracker}">
									<Border Width="46" Height="46" CornerRadius="10">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
												<GradientStop Color="#FFA14E" Offset="0"/>
												<GradientStop Color="#E8544C" Offset="1"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Viewbox Width="28" Height="28"
											 HorizontalAlignment="Center" VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<!-- 阶梯柱状图 -->
											<Rectangle Canvas.Left="3.2" Canvas.Top="13.5" Width="3.6" Height="7.5" RadiusX="1.2" RadiusY="1.2" Fill="#59FFFFFF"/>
											<Rectangle Canvas.Left="8.8" Canvas.Top="10.5" Width="3.6" Height="10.5" RadiusX="1.2" RadiusY="1.2" Fill="#8CFFFFFF"/>
											<Rectangle Canvas.Left="14.4" Canvas.Top="7" Width="3.6" Height="14" RadiusX="1.2" RadiusY="1.2" Fill="White"/>
											<!-- 上升折线 + 箭头 -->
											<Polyline Points="2.5,9.5 7.5,5.5 11.5,7.5 20.5,3" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
											<Polyline Points="16.8,2.6 20.8,2.9 20.4,6.6" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
										</Canvas>
									</Viewbox>
								</Panel>

								<!-- 网易云入口：网易红渐变 + 黑胶唱片/音符 -->
								<Panel IsVisible="{Binding IsNetease}">
									<Border Width="46" Height="46" CornerRadius="10">
										<Border.Background>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
												<GradientStop Color="#F4574D" Offset="0"/>
												<GradientStop Color="#C23232" Offset="1"/>
											</LinearGradientBrush>
										</Border.Background>
									</Border>
									<Viewbox Width="28" Height="28"
											 HorizontalAlignment="Center" VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<!-- 黑胶唱片（阴影盘 + 白圈 + 唱芯） -->
											<Ellipse Canvas.Left="2.6" Canvas.Top="4.6" Width="14.8" Height="14.8" Fill="#2E000000"/>
											<Ellipse Canvas.Left="3.8" Canvas.Top="5.8" Width="12.4" Height="12.4" Stroke="White" StrokeThickness="1.4" Fill="Transparent"/>
											<Ellipse Canvas.Left="7.6" Canvas.Top="9.6" Width="4.8" Height="4.8" Fill="White"/>
											<!-- 跳动的音符 -->
											<Line StartPoint="19.6,3.6" EndPoint="19.6,13.2" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
											<Ellipse Canvas.Left="16.4" Canvas.Top="12.2" Width="4.6" Height="3.6" Fill="White"/>
											<Path Data="M19.6 3.6 C21 4.1 21.9 5 22.1 6.5" Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round" Fill="Transparent"/>
										</Canvas>
									</Viewbox>
								</Panel>

								<!-- 抖音入口：黑底 + 青/红错位音符 logo -->
								<Panel IsVisible="{Binding IsDouyin}">
									<Border Width="46" Height="46" CornerRadius="10" Background="#161823"/>
									<Viewbox Width="26" Height="26"
											 HorizontalAlignment="Center" VerticalAlignment="Center">
										<Canvas Width="24" Height="24">
											<!-- 青色层（左下错位） -->
											<Canvas Canvas.Left="-0.9" Canvas.Top="0.9">
												<Line StartPoint="13.5,4" EndPoint="13.5,15.6" Stroke="#25F4EE" StrokeThickness="2.6" StrokeLineCap="Round"/>
												<Ellipse Canvas.Left="8" Canvas.Top="13.6" Width="6.6" Height="5.4" Fill="#25F4EE"/>
												<Path Data="M13.5 4.6 C14.6 7.4 17.2 9.2 20.2 9.4" Stroke="#25F4EE" StrokeThickness="2.6" StrokeLineCap="Round" Fill="Transparent"/>
											</Canvas>
											<!-- 红色层（右上错位） -->
											<Canvas Canvas.Left="0.9" Canvas.Top="-0.9">
												<Line StartPoint="13.5,4" EndPoint="13.5,15.6" Stroke="#FE2C55" StrokeThickness="2.6" StrokeLineCap="Round"/>
												<Ellipse Canvas.Left="8" Canvas.Top="13.6" Width="6.6" Height="5.4" Fill="#FE2C55"/>
												<Path Data="M13.5 4.6 C14.6 7.4 17.2 9.2 20.2 9.4" Stroke="#FE2C55" StrokeThickness="2.6" StrokeLineCap="Round" Fill="Transparent"/>
											</Canvas>
											<!-- 白色主体 -->
											<Canvas>
												<Line StartPoint="13.5,4" EndPoint="13.5,15.6" Stroke="White" StrokeThickness="2.6" StrokeLineCap="Round"/>
												<Ellipse Canvas.Left="8" Canvas.Top="13.6" Width="6.6" Height="5.4" Fill="White"/>
												<Path Data="M13.5 4.6 C14.6 7.4 17.2 9.2 20.2 9.4" Stroke="White" StrokeThickness="2.6" StrokeLineCap="Round" Fill="Transparent"/>
											</Canvas>
										</Canvas>
									</Viewbox>
								</Panel>

								<!-- 普通聊天：绿色 + 微信气泡 -->
								<Panel IsVisible="{Binding !IsSpecialEntry}">
									<Border Width="46" Height="46" CornerRadius="8" Background="#07C160"/>
									<Canvas Width="28" Height="28"
											HorizontalAlignment="Center" VerticalAlignment="Center">
										<Rectangle Canvas.Left="1"  Canvas.Top="1"
												   Width="22" Height="17"
												   RadiusX="3" RadiusY="3"
												   Fill="White"/>
										<Polygon Points="4,18 1,25 11,18" Fill="White"/>
										<Rectangle Canvas.Left="5"  Canvas.Top="6"  Width="14" Height="2" Fill="#07C160"/>
										<Rectangle Canvas.Left="5"  Canvas.Top="10" Width="10" Height="2" Fill="#07C160"/>
									</Canvas>
									<Border Background="#FF4444" CornerRadius="10"
											MinWidth="18" Height="18"
											HorizontalAlignment="Right" VerticalAlignment="Top"
											Padding="3,0"
											IsVisible="{Binding HasUnread}"
											Margin="0,-5,-5,0">
										<TextBlock Text="{Binding Unread}"
												   FontSize="11" Foreground="White"
												   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</Panel>

							</Panel>

							<!-- ── 名称 + 预览 ── -->
							<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
								<TextBlock Text="{Binding Name}"
										   FontSize="16"
										   Foreground="{DynamicResource SemiColorText0}"/>
								<TextBlock Text="{Binding Preview}"
										   FontSize="13"
										   Foreground="{DynamicResource SemiColorText2}"
										   TextTrimming="CharacterEllipsis"/>
							</StackPanel>

							<!-- ── 右侧 ── -->
							<!-- 功能入口显示箭头 -->
							<Viewbox Grid.Column="2"
									 Width="16" Height="16"
									 VerticalAlignment="Center"
									 IsVisible="{Binding IsSpecialEntry}">
								<Canvas Width="24" Height="24">
									<Path Data="M10 6L8.59 7.41 13.17 12L8.59 16.59 10 18L16 12Z"
										  Fill="{DynamicResource SemiColorText2}"/>
								</Canvas>
							</Viewbox>

							<!-- 普通聊天显示时间 -->
							<TextBlock Grid.Column="2"
									   Text="{Binding Time}"
									   FontSize="12"
									   Foreground="{DynamicResource SemiColorText2}"
									   VerticalAlignment="Top" Margin="0,14,0,0"
									   HorizontalAlignment="Right"
									   IsVisible="{Binding !IsSpecialEntry}"/>
						</Grid>
					</Button>
					<Rectangle Height="0.6" Fill="{DynamicResource SemiColorBorder}" Margin="72,0,0,0"/>
				</StackPanel>
			</DataTemplate>
		</ListBox.ItemTemplate>

		<ListBox.ItemContainerTheme>
			<ControlTheme TargetType="ListBoxItem">
				<Setter Property="Padding" Value="0"/>
				<Setter Property="Background" Value="Transparent"/>
				<Style Selector="^:pointerover /template/ ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource SemiColorFillQuaternary}"/>
				</Style>
				<Style Selector="^:selected /template/ ContentPresenter">
					<Setter Property="Background" Value="{DynamicResource SemiColorFillTertiary}"/>
				</Style>
			</ControlTheme>
		</ListBox.ItemContainerTheme>
	</ListBox>
</UserControl>
