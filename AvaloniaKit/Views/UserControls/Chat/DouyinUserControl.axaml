<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:AvaloniaKit.ViewModels.UserControls.Chat"
			 x:Class="AvaloniaKit.Views.UserControls.Chat.DouyinUserControl"
			 d:DesignWidth="390" d:DesignHeight="760"
			 x:DataType="vm:DouyinViewModel">

	<Design.DataContext>
		<vm:DouyinViewModel/>
	</Design.DataContext>

	<UserControl.Styles>
		<Style Selector="Button.icon-btn">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="Padding"         Value="8"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<!-- 标题栏 关注/推荐 Tab（抖音风：未选半透白，选中白色加粗带下划线） -->
		<Style Selector="Button.dy-tab">
			<Setter Property="Background"      Value="Transparent"/>
			<Setter Property="Foreground"      Value="#A0FFFFFF"/>
			<Setter Property="FontSize"        Value="16"/>
			<Setter Property="Padding"         Value="6,2"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="Button.dy-tab.active">
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
		<Style Selector="Button.dy-tab:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.dy-tab Border.dy-underline">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="Button.dy-tab.active Border.dy-underline">
			<Setter Property="Background" Value="White"/>
		</Style>
	</UserControl.Styles>

	<!-- 视频界面由平台 WebView 覆盖层呈现（共享 HTML，从标题栏以下开始）；
	     顶部保留与音乐模块一致的 Avalonia 标题栏 + 统一样式返回按钮 -->
	<DockPanel Background="Black">

		<!-- ★ 标题栏（高度 52，与 DouyinViewModel.TopOffsetDip 对应） -->
		<Border DockPanel.Dock="Top" Height="52"
				Background="#161823"
				BorderBrush="#22FFFFFF"
				BorderThickness="0,0,0,0.8"
				Padding="4,8">
			<Grid ColumnDefinitions="44,*,44">
				<Button Grid.Column="0" Classes="icon-btn"
						Command="{Binding GoBackCommand}"
						HorizontalAlignment="Center" VerticalAlignment="Center">
					<Viewbox Width="20" Height="20">
						<Canvas Width="24" Height="24">
							<Path Data="M20 11H7.83L13.42 5.41 12 4 4 12 12 20 13.41 18.59 7.83 13H20V11Z"
								  Fill="White"/>
						</Canvas>
					</Viewbox>
				</Button>
				<!-- 关注/推荐 Tab（取代原“抖音”标题，与抖音 App 顶栏一致） -->
				<StackPanel Grid.Column="1" Orientation="Horizontal"
							HorizontalAlignment="Center" VerticalAlignment="Center"
							Spacing="18">
					<Button Classes="dy-tab" Classes.active="{Binding IsFollowTab}"
							Command="{Binding SwitchTabCommand}" CommandParameter="0">
						<StackPanel Spacing="3">
							<TextBlock Text="关注" HorizontalAlignment="Center"/>
							<Border Classes="dy-underline" Height="3" Width="22"
									CornerRadius="2" HorizontalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Classes="dy-tab" Classes.active="{Binding IsRecommendTab}"
							Command="{Binding SwitchTabCommand}" CommandParameter="1">
						<StackPanel Spacing="3">
							<TextBlock Text="推荐" HorizontalAlignment="Center"/>
							<Border Classes="dy-underline" Height="3" Width="22"
									CornerRadius="2" HorizontalAlignment="Center"/>
						</StackPanel>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 黑底承托 + 服务缺失时的占位提示 -->
		<Grid Background="Black">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
						Spacing="14" IsVisible="{Binding !HasService}">
				<TextBlock Text="📵" FontSize="44" HorizontalAlignment="Center"/>
				<TextBlock Text="当前平台暂不支持视频播放"
						   FontSize="15" Foreground="#B3FFFFFF"
						   HorizontalAlignment="Center"/>
				<Button Content="返 回"
						Command="{Binding GoBackCommand}"
						HorizontalAlignment="Center"
						Background="#FE2C55" Foreground="White"
						CornerRadius="20" Padding="26,8" BorderThickness="0"/>
			</StackPanel>
		</Grid>
	</DockPanel>
</UserControl>
